# Optional: the app works with Wikipedia and local saves without keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_flash_v2_5
# Enable anonymous sign-ins in Supabase Auth and apply supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to Scrollipedia/1.0 (mailto:YOUR_PUBLIC_EMAIL) or include a real project URL.
# Without contact information requests are paced conservatively for unidentified clients.
WIKIMEDIA_USER_AGENT=
# Protect paid APIs on public deployments. Set a random secret and use Vercel deployment protection.
INTEGRATIONS_ENABLED=true
